# Локальная PostgreSQL. Скопируйте в .env и измените пароль.
# .env содержит секреты и не должен попадать в Git.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=hackathon
POSTGRES_USER=bi_user
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_SCHEMA=raw

# LLM: OpenAI-совместимый API (например, локальный Ollama / vLLM).
# При проверке модель может быть заменена организаторами.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=
